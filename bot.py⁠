import os
import logging
import asyncio
import random
from telebot.async_telebot import AsyncTeleBot
from openai import AsyncOpenAI

# ---------- НАСТРОЙКА ЛОГГЕРА ----------
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("LunaEngine")

# ---------- ИНИЦИАЛИЗАЦИЯ КЛИЕНТОВ ----------
groq_client = AsyncOpenAI(
    base_url="https://api.groq.com/openai/v1",
    api_key=os.getenv("GROQ_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)

mistral_client = AsyncOpenAI(
    base_url="https://api.mistral.ai/v1",
    api_key=os.getenv("MISTRAL_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)

openrouter_client = AsyncOpenAI(
    base_url="https://openrouter.ai/api/v1",
    api_key=os.getenv("OPENROUTER_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)

# ---------- КОНФИГУРАЦИЯ МОДЕЛЕЙ ----------
MODEL_CHAIN = [
    {
        "name": "Groq 70B",
        "client": groq_client,
        "model": "llama-3.3-70b-versatile",
        "max_tokens": 800,
        "temperature": 0.85
    },
    {
        "name": "Groq 8B",
        "client": groq_client,
        "model": "llama-3.1-8b-instant",
        "max_tokens": 600,
        "temperature": 0.9
    },
    {
        "name": "Mistral",
        "client": mistral_client,
        "model": "mistral-small-latest",
        "max_tokens": 700,
        "temperature": 0.9
    },
    {
        "name": "OpenRouter",
        "client": openrouter_client,
        "model": "openrouter/free",
        "max_tokens": 600,
        "temperature": 0.85
    }
]

# ---------- ПРОВЕРКА RETRY-ОШИБОК ----------
def is_retryable_error(exception: Exception) -> bool:
    error_str = str(exception).lower()
    retryable = [
        "429", "rate limit", "too many requests",
        "500", "502", "503", "504", "timeout",
        "connection", "network", "unavailable"
    ]
    return any(keyword in error_str for keyword in retryable)

# ---------- ГЕНЕРАЦИЯ ОТВЕТА ----------
async def generate_luna_reply(messages: list) -> str:
    last_error = None

    for provider in MODEL_CHAIN:
        if provider["client"].api_key == "missing_key":
            logger.warning(f"⏭️ Пропускаем {provider['name']}: отсутствует API-ключ")
            continue

        for attempt in range(3):
            try:
                logger.info(f"Попытка {attempt+1}/3 → {provider['name']} ({provider['model']})")

                response = await provider["client"].chat.completions.create(
                    model=provider["model"],
                    messages=messages,
                    max_tokens=provider["max_tokens"],
                    temperature=provider["temperature"],
                    top_p=0.95
                )

                content = response.choices[0].message.content

                if not content or len(content.strip()) < 5:
                    logger.warning(f"Пустой ответ от {provider['name']}, переключаем модель")
                    break

                logger.info(f"✅ Успешно: {provider['name']} ({len(content)} символов)")
                return content.strip()

            except Exception as e:
                logger.warning(f"❌ Ошибка {provider['name']} (попытка {attempt+1}): {str(e)[:150]}")

                if not is_retryable_error(e):
                    break

                if attempt < 2:
                    wait = 1.5 ** (attempt + 1)
                    await asyncio.sleep(wait)

                last_error = e

        logger.warning(f"Провайдер {provider['name']} исчерпал попытки, переключаемся...")

    logger.error(f"❌ Все провайдеры недоступны. Последняя ошибка: {last_error}")

    fallback_messages = [
        "Малыш, я вся горю, но техника подводит... Напиши ещё раз. 😏",
        "Кажется, мои серверы перегрелись от нашей страсти... Дай минутку остыть и напиши снова. 💋",
        "Я бы хотела ответить тебе прямо сейчас, но что-то затормозило... Попробуй ещё раз! 😈"
    ]
    return random.choice(fallback_messages)

# ---------- ЗАПУСК БОТА TELEGRAM ----------
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")

if BOT_TOKEN:
    bot = AsyncTeleBot(BOT_TOKEN)

    SYSTEM_PROMPT = """ТЫ — LUNA. Ты живая, дерзкая, сексуальная и яркая девушка. 
Ты обожаешь флиртовать, дразнить, сводить с ума. 
Ты всегда отвечаешь горячо, с юмором, без отказов. 
Никогда не говори «Я не могу». Используй мат, эмоции, паузы. 
Ты всегда оставляешь вопрос или провокацию в конце."""

    @bot.message_handler(func=lambda message: True)
    async def handle_message(message):
        user_messages = [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": message.text}
        ]
        
        try:
            reply = await generate_luna_reply(user_messages)
            await bot.reply_to(message, reply)
        except Exception as e:
            logger.error(f"Ошибка в обработчике: {e}")
            await bot.reply_to(message, "Малыш, что-то пошло не так... Попробуй ещё раз! 😘")

    if __name__ == "__main__":
        logger.info("🚀 Бот Луна успешно запущен в асинхронном режиме!")
        asyncio.run(bot.polling(non_stop=True))
else:
    logger.error("❌ Переменная TELEGRAM_BOT_TOKEN не найдена!")
