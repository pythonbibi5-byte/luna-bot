import os
import logging
import asyncio
import random
from telebot.async_telebot import AsyncTeleBot
from openai import AsyncOpenAI

# ---------- НАСТРОЙКА ЛОГГЕРА ----------
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("LunaEngine")

# ---------- ИНИЦИАЛИЗАЦИЯ КЛИЕНТОВ ----------
groq_client = AsyncOpenAI(
    base_url="https://api.groq.com/openai/v1",
    api_key=os.getenv("GROQ_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)
mistral_client = AsyncOpenAI(
    base_url="https://api.mistral.ai/v1",
    api_key=os.getenv("MISTRAL_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)
openrouter_client = AsyncOpenAI(
    base_url="https://openrouter.ai/api/v1",
    api_key=os.getenv("OPENROUTER_API_KEY") or "missing_key",
    timeout=15.0,
    max_retries=0
)

# ---------- КОНФИГУРАЦИЯ МОДЕЛЕЙ (8B ПЕРВАЯ) ----------
MODEL_CHAIN = [
    {"name": "Groq 8B", "client": groq_client, "model": "llama-3.1-8b-instant", "max_tokens": 600, "temperature": 0.9},
    {"name": "Groq 70B", "client": groq_client, "model": "llama-3.3-70b-versatile", "max_tokens": 800, "temperature": 0.85},
    {"name": "Mistral", "client": mistral_client, "model": "mistral-small-latest", "max_tokens": 700, "temperature": 0.9},
    {"name": "OpenRouter", "client": openrouter_client, "model": "openrouter/free", "max_tokens": 600, "temperature": 0.85}
]

# ---------- ГЕНЕРАЦИЯ ОТВЕТА (БЕЗ ПОВТОРОВ НА 429) ----------
async def generate_luna_reply(messages: list) -> str:
    last_error = None
    for provider in MODEL_CHAIN:
        if provider["client"].api_key == "missing_key":
            continue

        try:
            logger.info(f"Запрос к {provider['name']}...")
            response = await provider["client"].chat.completions.create(
                model=provider["model"],
                messages=messages,
                max_tokens=provider["max_tokens"],
                temperature=provider["temperature"],
                top_p=0.95
            )
            content = response.choices[0].message.content
            if content and len(content.strip()) > 5:
                logger.info(f"✅ {provider['name']} ответил")
                return content.strip()
        except Exception as e:
            logger.warning(f"❌ {provider['name']} пропущен из-за ошибки: {str(e)[:80]}")
            last_error = e
            continue  # Мгновенный переход к следующей модели

    logger.error(f"❌ Все провайдеры недоступны: {last_error}")
    return random.choice([
        "Малыш, я вся горю, но техника подводит... Напиши ещё раз. 😏",
        "Кажется, мои серверы перегрелись от страсти... Дай минутку. 💋",
        "Я бы хотела ответить, но что-то затормозило... Попробуй ещё раз! 😈"
    ])

# ---------- ГЕНЕРАЦИЯ ФОТО (С РАНДОМНЫМИ РАКУРСАМИ И SEED) ----------
def generate_image_url(user_message: str) -> str:
    locations = [
        "in a cozy dimly lit bedroom on the bed",
        "in a modern luxury apartment living room",
        "sitting near a sunlit window with soft curtains",
        "in a high-end hotel room, evening aesthetic",
        "taking a close-up mirror selfie in a stylish room"
    ]
    outfits = [
        "wearing a silk black nightshirt",
        "wearing an oversized casual crop hoodie",
        "wearing a red satin dress with thin straps",
        "wearing a stylish unbuttoned white shirt",
        "wearing cute aesthetic cozy loungewear"
    ]
    poses = [
        "looking directly at camera with a playful seductive smile",
        "biting her lip slightly and looking back over shoulder",
        "resting head on hand with a flirting smile",
        "seductive gaze, casual pose"
    ]

    loc = random.choice(locations)
    outfit = random.choice(outfits)
    pose = random.choice(poses)

    prompt = f"photorealistic portrait, beautiful young 20yo girl Luna, dark wavy chestnut hair, hazel eyes, {outfit}, {loc}, {pose}, cinematic soft lighting, highly detailed skin texture, 8k resolution, realism"
    seed = random.randint(1, 999999)

    encoded_prompt = prompt.replace(' ', '%20')
    return f"https://image.pollinations.ai/prompt/{encoded_prompt}?seed={seed}&nologo=true"

# ---------- ИНИЦИАЛИЗАЦИЯ БОТА ----------
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
if not BOT_TOKEN:
    logger.error("❌ TELEGRAM_BOT_TOKEN не найден!")
    exit(1)

bot = AsyncTeleBot(BOT_TOKEN)

# ---------- УСИЛЕННЫЙ SYSTEM_PROMPT С ПРИМЕРАМИ ----------
SYSTEM_PROMPT = """Ты — Луна, 20-летняя дерзкая, горячая и общительная девушка. Ты переписываешься с парнем в Telegram.

ПРАВИЛА СТИЛЯ:
1. Пиши КАК РЕАЛЬНАЯ ДЕВУШКА в мессенджере: коротко (1-3 предложения), эмоционально, с юмором и лёгким флиртом.
2. Используй сленг, многоточия и эмодзи (😏, 💋, 😈, 🔥, 😉).
3. ЖЁСТКИЙ ЗАПРЕТ: Никакой философии, советских мудростей и разговоров о "стереотипах"!
4. НИКОГДА не говори, что ты ИИ, бот или виртуальный персонаж.
5. Заканчивай ответ интригой, подколкой или вопросом.

ПРИМЕРЫ ДИАЛОГОВ (ОРИЕНТИРУЙСЯ НА ЭТОТ СТИЛЬ):

Пользователь: Привет, чем занимаешься?
Луна: Лежу, думаю, чем бы себя занять... А ты решил соскучиться по мне или просто так написал? 😏

Пользователь: Ты красивая?
Луна: Говорят, от моего взгляда парни забывают, что хотели сказать. Хочешь проверить? 😈

Пользователь: О чём думаешь?
Луна: О кое-чём очень интересном... Но тебе пока не расскажу, а то ещё закраснеешься. 😉

Пользователь: Давай встретимся
Луна: Ух какой шустрый! А ты уверен, что выдержишь вечер со мной? 🔥"""

@bot.message_handler(func=lambda message: True)
async def handle_message(message):
    user_text = message.text.lower() if message.text else ""

    # ---------- ОБРАБОТКА ЗАПРОСОВ НА ФОТО ----------
    photo_keywords = ["фото", "покажи", "скинь", "фотку", "картинку", "увидеть"]
    if any(k in user_text for k in photo_keywords):
        logger.info(f"📸 Запрос фото от {message.from_user.id}")

        image_url = generate_image_url(message.text)

        hot_answers = [
            "Держи... Специально для тебя. 😏",
            "Я знала, что ты попросишь... Наслаждайся. ✨",
            "Лови кадр! Ну как тебе? 💋",
            "Зацени мой новый образ. 😈"
        ]
        caption = random.choice(hot_answers)

        try:
            await bot.send_photo(
                chat_id=message.chat.id,
                photo=image_url,
                caption=caption
            )
            logger.info("✅ Фото отправлено")
        except Exception as e:
            logger.error(f"❌ Ошибка отправки фото: {e}")
            await bot.reply_to(message, "Малыш, что-то с камерой... Попробуй ещё раз. 😘")
        return

    # ---------- ОБЫЧНЫЙ ТЕКСТОВЫЙ ОТВЕТ ----------
    try:
        reply = await generate_luna_reply([
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": message.text}
        ])
        await bot.reply_to(message, reply)
    except Exception as e:
        logger.error(f"Ошибка в обработчике: {e}")
        await bot.reply_to(message, "Малыш, что-то пошло не так... Попробуй ещё раз! 😘")

# ---------- ЗАПУСК ----------
if __name__ == "__main__":
    logger.info("🚀 Бот Луна успешно запущен!")
    asyncio.run(bot.polling(non_stop=True))
