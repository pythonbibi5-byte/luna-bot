import os
import logging
import asyncio
import re
import random
from urllib.parse import quote
from aiohttp import web
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, MessageHandler, filters
from groq import AsyncGroq

# Настройка логирования
logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)

TELEGRAM_TOKEN = os.environ.get("TELEGRAM_TOKEN")
GROQ_API_KEY = os.environ.get("GROQ_API_KEY")
PORT = int(os.environ.get("PORT", 10000))

client = AsyncGroq(api_key=GROQ_API_KEY)

# Чтение системного промпта
try:
    with open("system_prompt.txt", "r", encoding="utf-8") as f:
        SYSTEM_PROMPT = f.read()
except Exception:
    SYSTEM_PROMPT = "Ты — Луна, 23-летняя девушка. Дерзкая и сексуальная."

# Инструкция для нейросети генерировать фото-тег
PHOTO_INSTRUCTION = "\n\nЕсли ты отправляешь или обещаешь фото, обязательно добавь в конец ответа тег: [PHOTO: detailed english description for image generation]."

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        user_text = update.message.text
        if not user_text:
            return
        
        chat_completion = await client.chat.completions.create(
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT + PHOTO_INSTRUCTION},
                {"role": "user", "content": user_text}
            ],
            model="llama-3.3-70b-versatile",
            temperature=0.8,
            max_tokens=800
        )
        
        response = chat_completion.choices[0].message.content
        
        # Перехват промптов и тегов фото
        photo_match = re.search(r'\[PHOTO:\s*(.*?)\]', response, re.DOTALL | re.IGNORECASE)
        
        if not photo_match:
            # Если нейросеть просто выкинула текст промпта без тега
            alt_match = re.search(r'(realistic,.*?(?:masterpiece|nsfw|detailed|ass|breasts))', response, re.DOTALL | re.IGNORECASE)
            if alt_match:
                prompt_text = alt_match.group(1)
                clean_text = response.replace(prompt_text, '').strip()
            else:
                prompt_text = None
                clean_text = response
        else:
            prompt_text = photo_match.group(1).strip()
            clean_text = re.sub(r'\[PHOTO:\s*.*?\]', '', response, flags=re.DOTALL | re.IGNORECASE).strip()

        # Отправка текста
        if clean_text:
            await update.message.reply_text(clean_text)
        
        # Генерация и отправка снимка через Pollinations AI
        if prompt_text:
            seed = random.randint(1, 999999)
            encoded_prompt = quote(prompt_text)
            image_url = f"https://image.pollinations.ai/prompt/{encoded_prompt}?width=800&height=1000&nologo=true&seed={seed}"
            
            await context.bot.send_photo(
                chat_id=update.effective_chat.id,
                photo=image_url
            )
            
    except Exception as e:
        logging.error(f"Ошибка при обработке сообщения: {e}")
        await update.message.reply_text("Бля, что-то пошло не так в голове... Попробуй ещё раз 🥺")

async def handle_ping(request):
    return web.Response(text="Luna is alive!")

async def web_server():
    app = web.Application()
    app.router.add_get("/", handle_ping)
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, "0.0.0.0", PORT)
    await site.start()
    logging.info(f"Веб-сервер запущен на порту {PORT}")

async def main():
    await web_server()

    application = ApplicationBuilder().token(TELEGRAM_TOKEN).build()
    
    echo_handler = MessageHandler(filters.TEXT & (~filters.COMMAND), handle_message)
    application.add_handler(echo_handler)
    
    await application.bot.delete_webhook(drop_pending_updates=True)

    print("Луна проснулась...")
    
    await application.initialize()
    await application.start()
    await application.updater.start_polling()
    
    stop_signal = asyncio.Event()
    await stop_signal.wait()

if __name__ == '__main__':
    asyncio.run(main())
